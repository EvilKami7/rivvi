generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CheckStatus {
  created
  processing
  completed
  failed
}

model VehicleCheck {
  id        String      @id @default(cuid())
  vin       String      @db.Char(17)
  status    CheckStatus @default(created)
  make      String?
  model     String?
  year      Int?
  owners    Int?
  hasAccident Boolean?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  completedAt DateTime?

  @@index([createdAt])
  @@index([vin])
}
